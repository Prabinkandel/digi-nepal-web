# ── Digi Nepal — Environment Variables ─────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is in .gitignore.

# ── Session ────────────────────────────────────────────────
SESSION_SECRET=replace-this-with-a-unique-32-character-secret

# ── Database (production: MongoDB Atlas) ───────────────────
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/digi-nepal

# ── Application URL (production) ───────────────────────────
# APP_URL=https://diginepalnp.com

# ── Google OAuth (sign-in with Google) ─────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REDIRECT_URI=https://diginepalnp.com/api/auth/google/callback

# ── Local development only ─────────────────────────────────
LOCAL_AUTH_AUTO_VERIFY=true

# ── Email / SMTP (Gmail App Password recommended) ──────────
ADMIN_EMAIL=your-admin@gmail.com
CONTACT_EMAIL=your-admin@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-admin@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Digi Nepal <your-admin@gmail.com>
